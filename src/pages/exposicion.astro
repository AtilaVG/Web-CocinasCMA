---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Foto from '../components/Foto.astro';
import Icon from '../components/Icon.astro';
import Horario from '../components/Horario.astro';
import { huecos, proporcion, tiraExposicion } from '../data/fotos';
import { acabados, acabadosExposicion, type Acabado } from '../data/catalogo';
import { proyectos } from '../data/proyectos';
import { empresa, telPrincipal } from '../config/empresa';
import { url } from '../lib/url';

const { tienda } = empresa;

const materiales = acabadosExposicion.map((slug) => ({
  slug,
  ...(acabados[slug] as Acabado),
  enGaleria: proyectos.some((p) => (p.acabados as string[]).includes(slug)),
}));

const encontraras = [
  {
    titulo: 'Cocinas montadas',
    texto: 'Ambientes completos para hacerte una idea real de tamaños, distribución y acabados.',
  },
  {
    titulo: 'Frentes y colores',
    texto: 'Muestras de todos nuestros acabados para comparar con calma, a la luz del día.',
  },
  {
    titulo: 'Encimeras',
    texto: 'Piedra sinterizada Neolith, estratificados y otros materiales para la superficie que más se usa.',
  },
  {
    titulo: 'Baños y armarios',
    texto: 'También diseñamos y fabricamos muebles de baño y armarios a medida, con los mismos materiales.',
  },
];
---

<Base
  titulo="Exposición de cocinas en Humanes de Madrid"
  descripcion="Visita nuestra exposición de más de 700 m² en Humanes de Madrid: cocinas montadas, frentes en laca, madera, cristal, estratificado, acrílico y encimeras Neolith."
  headerTransparente
>
  <PageHero
    antetitulo="Exposición · Humanes de Madrid"
    titulo="700&nbsp;m² para ver, tocar y <em>decidir sin prisas</em>"
    intro="Una cocina se elige mejor en persona. En nuestra tienda de la Avenida de Fuenlabrada puedes abrir cajones, comparar acabados y hablar con quien la va a fabricar."
    foto={huecos.exposicionHero}
  />

  <section class="section encontraras" aria-labelledby="encontraras-titulo">
    <div class="container encontraras__grid">
      <div class="encontraras__texto">
        <p class="eyebrow" data-reveal>En la tienda</p>
        <h2 id="encontraras-titulo" data-reveal style="--d: 0.08s">Qué vas a encontrar</h2>
        <ul class="encontraras__lista" role="list">
          {
            encontraras.map((e, i) => (
              <li data-reveal style={`--d: ${i * 0.06}s`}>
                <h3>{e.titulo}</h3>
                <p class="muted">{e.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="encontraras__fotos">
        <div class="media encontraras__foto encontraras__foto--1" data-reveal="imagen">
          <Foto
            src={huecos.exposicionAmbiente1.foto}
            alt={huecos.exposicionAmbiente1.alt}
            pendiente={huecos.exposicionAmbiente1.pendiente}
            sizes="(min-width: 56em) 45vw, 100vw"
            posicion="arriba"
          />
        </div>
        <div class="media encontraras__foto encontraras__foto--2" data-reveal="imagen" style="--d: 0.12s">
          <Foto
            src={huecos.exposicionAmbiente2.foto}
            alt={huecos.exposicionAmbiente2.alt}
            pendiente={huecos.exposicionAmbiente2.pendiente}
            sizes="(min-width: 56em) 30vw, 70vw"
            tono="madera"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight tira" aria-labelledby="tira-titulo">
    <div class="container">
      <div class="tira__cabecera">
        <h2 id="tira-titulo" class="tira__titulo" data-reveal>Un paseo por la exposición</h2>
        <p class="muted small" data-reveal style="--d: 0.08s">
          <span class="tag-pendiente">Fotos provisionales</span> Imágenes actuales de la tienda, pequeñas: pendiente un
          reportaje nuevo.
        </p>
      </div>
      <ul class="tira__lista" role="list">
        {
          tiraExposicion.map((f, i) => (
            <li class="media tira__foto" data-reveal style={`--d: ${(i % 3) * 0.06}s`}>
              <Foto src={f.foto} alt={f.alt} sizes="(min-width: 64em) 30vw, 50vw" anchos={[300]} compacto />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--cream materiales" aria-labelledby="materiales-titulo">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Materiales y acabados</p>
          <h2 id="materiales-titulo" data-reveal style="--d: 0.08s">Elige cómo quieres que sea tu cocina</h2>
        </div>
        <p class="muted" data-reveal style="--d: 0.16s">
          Estos son los acabados con los que trabajamos. Las muestras de color son orientativas: lo mejor es verlos en
          la exposición.
        </p>
      </div>

      <ul class="materiales__grid" role="list">
        {
          materiales.map((m, i) => (
            <li class="material" data-reveal style={`--d: ${(i % 4) * 0.06}s`}>
              <div class={`muestra ${m.muestra}`} aria-hidden="true" />
              <div class="material__texto">
                <h3>{m.nombre}</h3>
                <p class="muted">{m.descripcion}</p>
                {m.pendiente && <span class="tag-pendiente">Descripción por validar</span>}
                {m.enGaleria && (
                  <a class="material__enlace" href={url(`/proyectos/?acabado=${m.slug}`)}>
                    Ver cocinas con este acabado <Icon name="arrow" />
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      <p class="materiales__nota muted small" data-reveal>
        <span class="tag-pendiente">Pendiente</span> Marcas de encimeras, herrajes y electrodomésticos con las que
        trabajamos.
      </p>
    </div>
  </section>

  <section class="section visita-info" aria-labelledby="visita-titulo">
    <div class="container visita-info__grid">
      <div
        class="media visita-info__foto"
        style={`aspect-ratio: ${proporcion(huecos.exposicionFachada.foto, '4 / 3')}`}
        data-reveal="imagen"
      >
        <Foto
          src={huecos.exposicionFachada.foto}
          alt={huecos.exposicionFachada.alt}
          pendiente={huecos.exposicionFachada.pendiente}
          sizes="(min-width: 56em) 45vw, 100vw"
        />
      </div>
      <div>
        <p class="eyebrow" data-reveal>Visítanos</p>
        <h2 id="visita-titulo" data-reveal style="--d: 0.08s">Cómo llegar</h2>
        <address class="visita-info__direccion" data-reveal style="--d: 0.12s">
          {tienda.calle}<br />
          {tienda.cp} {tienda.localidad} ({tienda.provincia})<br />
          <span class="muted">{tienda.referencia}</span>
        </address>
        <div data-reveal style="--d: 0.16s">
          <Horario />
        </div>
        <p class="visita-info__consejo muted" data-reveal style="--d: 0.2s">
          Si vienes con las medidas de tu cocina (o unas fotos), podremos avanzar mucho más en la primera visita. Y si
          prefieres que te dediquemos un rato sin esperas, llámanos antes.
        </p>
        <div class="btn-row" data-reveal style="--d: 0.24s">
          <a class="btn" href={tienda.mapa} target="_blank" rel="noopener">
            <Icon name="pin" /> Abrir en Google Maps
            <span class="visually-hidden">(pestaña nueva)</span>
          </a>
          <a class="btn btn--ghost" href={`tel:${telPrincipal.e164}`}><Icon name="phone" /> {telPrincipal.texto}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .encontraras__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 6rem);
    align-items: center;
  }

  @media (min-width: 56em) {
    .encontraras__grid {
      grid-template-columns: 1fr 1.1fr;
    }
  }

  .encontraras__texto h2 {
    margin-bottom: 2.25rem;
  }

  .encontraras__lista {
    display: grid;
  }

  .encontraras__lista li {
    padding-block: 1.25rem;
    border-top: 1px solid var(--c-line);
  }

  .encontraras__lista h3 {
    margin-bottom: 0.35rem;
    font-size: 1.4rem;
  }

  .encontraras__fotos {
    position: relative;
    padding-bottom: 22%;
  }

  .encontraras__foto--1 {
    aspect-ratio: 5 / 4;
    width: 88%;
    margin-left: auto;
  }

  .encontraras__foto--2 {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 48%;
    aspect-ratio: 4 / 5;
    border: clamp(0.4rem, 1vw, 0.75rem) solid var(--c-paper);
  }

  /* Tira de fotos de la exposición */
  .tira {
    padding-top: 0;
  }

  .tira__cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-bottom: 1.5rem;
  }

  .tira__titulo {
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem);
  }

  .tira__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (min-width: 56em) {
    .tira__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .tira__foto {
    aspect-ratio: 5 / 2;
  }

  /* Materiales */
  .materiales__grid {
    display: grid;
    gap: 2rem 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 40em) {
    .materiales__grid {
      gap: 2.5rem 1.5rem;
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    }
  }

  .material {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .material__texto {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .material h3 {
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem);
  }

  .material__texto > p {
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .material__enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--c-navy);
  }

  .material__enlace :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .materiales__nota {
    margin-top: 3rem;
  }

  /* Muestras: ilustraciones CSS orientativas, no fotos */
  .muestra {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--c-stone);
    box-shadow: inset 0 0 0 1px rgb(2 15 61 / 0.08);
  }

  .muestra--laca-brillo {
    background:
      linear-gradient(115deg, rgb(255 255 255 / 0) 30%, rgb(255 255 255 / 0.75) 42%, rgb(255 255 255 / 0) 52%),
      linear-gradient(160deg, #fbfaf7, #e9e6df);
  }

  .muestra--laca-textura {
    background:
      radial-gradient(circle at 20% 30%, rgb(0 0 0 / 0.05) 0 1px, transparent 1.5px) 0 0 / 5px 5px,
      radial-gradient(circle at 70% 60%, rgb(255 255 255 / 0.35) 0 1px, transparent 1.5px) 0 0 / 7px 7px,
      #8c9184;
  }

  .muestra--cristal {
    background:
      linear-gradient(0deg, #b9c0c4 0 6%, #8e979c 6% 7.5%, transparent 7.5%),
      linear-gradient(120deg, rgb(255 255 255 / 0) 35%, rgb(255 255 255 / 0.4) 45%, rgb(255 255 255 / 0) 55%),
      linear-gradient(160deg, #3b4346, #20272b);
  }

  .muestra--madera {
    background:
      repeating-linear-gradient(
        92deg,
        rgb(80 50 20 / 0.12) 0 2px,
        transparent 2px 9px,
        rgb(80 50 20 / 0.08) 9px 10px,
        transparent 10px 17px
      ),
      linear-gradient(0deg, #6b4a2c 0 9%, transparent 9%),
      linear-gradient(180deg, #b78a5c, #a27547);
  }

  .muestra--estratificado {
    background:
      repeating-linear-gradient(45deg, rgb(255 255 255 / 0.05) 0 2px, transparent 2px 6px),
      linear-gradient(160deg, #6f6a63, #57534d);
  }

  .muestra--mate {
    background: linear-gradient(160deg, #e8e3da, #dbd4c8);
  }

  .muestra--luxe {
    background:
      linear-gradient(115deg, rgb(255 255 255 / 0) 30%, rgb(255 255 255 / 0.25) 45%, rgb(255 255 255 / 0) 55%),
      linear-gradient(160deg, #23324f, #121c33);
  }

  .muestra--polilaminado {
    background:
      linear-gradient(90deg, transparent 0 46%, rgb(0 0 0 / 0.08) 46% 47%, transparent 47%),
      linear-gradient(160deg, #d9cdbb, #c7b89f);
  }

  .muestra--acrilico {
    background:
      linear-gradient(115deg, rgb(255 255 255 / 0) 28%, rgb(255 255 255 / 0.55) 40%, rgb(255 255 255 / 0) 50%),
      linear-gradient(160deg, #a3192a, #6d0b18);
  }

  .muestra--alpicord {
    background:
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.06) 0 1px, transparent 1px 4px),
      linear-gradient(160deg, #a59a8a, #8a7f70);
  }

  .muestra--neolith {
    background:
      radial-gradient(ellipse at 30% 40%, rgb(255 255 255 / 0.6), transparent 40%),
      linear-gradient(125deg, transparent 40%, rgb(120 120 125 / 0.35) 41%, transparent 43%),
      linear-gradient(150deg, transparent 60%, rgb(140 140 145 / 0.25) 61%, transparent 62.5%),
      linear-gradient(160deg, #f1efeb, #dedbd5);
  }

  .muestra--impresion {
    background:
      radial-gradient(circle at 25% 35%, #c9a27a 0 18%, transparent 19%),
      radial-gradient(circle at 70% 65%, #7f8f86 0 22%, transparent 23%),
      linear-gradient(160deg, #efe7da, #e2d6c4);
  }

  .muestra--aluminio {
    background:
      linear-gradient(90deg, #b8bcc0 0 7%, transparent 7% 93%, #b8bcc0 93%),
      linear-gradient(0deg, #b8bcc0 0 7%, transparent 7% 93%, #b8bcc0 93%),
      linear-gradient(160deg, rgb(160 175 180 / 0.55), rgb(110 125 130 / 0.55)),
      repeating-linear-gradient(90deg, #d3d6d9 0 2px, #c3c7cb 2px 4px);
  }

  /* Visita */
  .visita-info__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 5rem);
    align-items: center;
  }

  @media (min-width: 56em) {
    .visita-info__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .visita-info__foto {
    aspect-ratio: 4 / 3;
  }

  .visita-info__grid h2 {
    margin-bottom: 1.5rem;
  }

  .visita-info__direccion {
    margin-bottom: 1.75rem;
    font-size: 1.15rem;
    font-style: normal;
    line-height: 1.6;
  }

  .visita-info__consejo {
    margin-block: 1.75rem 2rem;
  }
</style>
