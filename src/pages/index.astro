---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Icon from '../components/Icon.astro';
import Valoracion from '../components/Valoracion.astro';
import VisitaExposicion from '../components/VisitaExposicion.astro';
import { huecos } from '../data/fotos';
import { destacados } from '../data/proyectos';
import { nombreAcabado, nombreEstilo } from '../data/catalogo';
import { url } from '../lib/url';
import { secuencia } from '../data/intro';

const pilares = [
  {
    icono: 'saw',
    titulo: 'Fabricación propia',
    texto:
      'Cada mueble sale de nuestra fábrica de más de 2.000 m² en Cedillo del Condado (Toledo). Controlamos la calidad de principio a fin y, sin intermediarios, ajustamos el precio.',
    enlace: { texto: 'Ver la fábrica', ruta: '/fabrica/' },
  },
  {
    icono: 'ruler',
    titulo: 'Diseño a medida',
    texto:
      'Medimos tu espacio y diseñamos la cocina pieza a pieza, a tu gusto y a tu manera de cocinar. Antes de fabricar nada, te enseñamos cómo va a quedar.',
    enlace: { texto: 'Ver proyectos', ruta: '/proyectos/' },
  },
  {
    icono: 'showroom',
    titulo: '700 m² de exposición',
    texto:
      'En Humanes de Madrid puedes ver cocinas montadas, comparar acabados y tocar los materiales antes de decidir. Sin prisas y con quien la va a fabricar.',
    enlace: { texto: 'Visitar la exposición', ruta: '/exposicion/' },
  },
] as const;

const cifras = [
  { valor: '+2.000 m²', texto: 'de fábrica propia en Toledo' },
  { valor: '+30 años', texto: 'de oficio familiar' },
  { valor: '700 m²', texto: 'de exposición en Humanes' },
];
---

<Base
  tituloCompleto="Cocinas CMA · Cocinas a medida en Humanes de Madrid, de fábrica propia desde 1992"
  titulo="Inicio"
  descripcion="Fábrica y tienda familiar de cocinas a medida en Humanes de Madrid, cerca de Fuenlabrada, Leganés y Móstoles. Diseñamos y fabricamos cada cocina desde 1992. Visita nuestra exposición de 700 m²."
  headerTransparente
>
  <!-- Portada: intro con puertas que se abren al hacer scroll -->
  <section class:list={['intro', { 'intro--video': secuencia.total > 1 }]} data-intro aria-labelledby="portada-titulo">
    <div class="hero on-dark" data-intro-escena>
      <div class="hero__escena">
        <div class="media media--fill hero__media">
          <Foto
            src={huecos.inicioHero.foto}
            alt={huecos.inicioHero.alt}
            pendiente={huecos.inicioHero.pendiente}
            prioridad
            tono="oscuro"
            posicion="arriba"
            minAncho={1600}
          />
        </div>
        {
          secuencia.total > 1 && (
            <canvas
              class="hero__canvas"
              data-intro-canvas
              data-base={url(secuencia.carpeta)}
              data-total={secuencia.total}
              data-ext={secuencia.extension}
              aria-hidden="true"
            />
          )
        }
      </div>
      {secuencia.total > 1 && secuencia.aviso && <span class="foto-aviso hero__aviso">{secuencia.aviso}</span>}
      {
        secuencia.total > 1 && (
          <div class="intro__marca" aria-hidden="true">
            <span class="puerta__marca">
              cocinas<b>cma</b>
            </span>
            <span class="puerta__dato">Fábrica de mobiliario de cocinas · Desde 1992</span>
            <span class="puertas__aviso">
              Desliza para entrar
              <Icon name="arrow-down" />
            </span>
          </div>
        )
      }
      <div class="hero__velo" aria-hidden="true"></div>

      {
        secuencia.total < 2 && (
          <div class="puertas" aria-hidden="true">
            <div class="puerta puerta--izq">
              <div class="puerta__frente">
                <span class="puerta__gola" />
                <span class="puerta__marca">cocinas</span>
                <span class="puerta__dato">Desde 1992</span>
              </div>
              <div class="puerta__dorso" />
            </div>
            <div class="puerta puerta--der">
              <div class="puerta__frente">
                <span class="puerta__gola" />
                <span class="puerta__marca">
                  <b>cma</b>
                </span>
                <span class="puerta__dato">Humanes de Madrid</span>
              </div>
              <div class="puerta__dorso" />
            </div>
            <span class="puertas__aviso">
              Desliza para abrir
              <Icon name="arrow-down" />
            </span>
          </div>
        )
      }

      <div class="container hero__contenido">
        <p class="eyebrow hero__antetitulo">Fábrica de mobiliario de cocinas</p>
        <h1 id="portada-titulo" class="hero__titulo">
          Cocinas a medida, <em>fabricadas por nosotros</em> desde&nbsp;1992
        </h1>
        <p class="hero__intro">
          Diseñamos cada cocina para su espacio y la fabricamos en nuestra fábrica de Toledo. Más de 30 años de oficio
          familiar, sin intermediarios.
        </p>
        <div class="btn-row">
          <a class="btn btn--light" href={url('/proyectos/')}>Ver proyectos</a>
          <a class="btn btn--ghost-light" href={url('/exposicion/')}>Visitar la exposición</a>
        </div>
      </div>

      <div class="container hero__pie" aria-hidden="true">
        <span>Humanes de Madrid · Cedillo del Condado</span>
        <span class="hero__scroll"><Icon name="arrow-down" /></span>
      </div>
    </div>
  </section>

  <!-- Presentación -->
  <section class="section manifiesto">
    <div class="container manifiesto__grid">
      <p class="eyebrow" data-reveal>Desde 1992</p>
      <div>
        <p class="manifiesto__texto" data-pintar>
          Somos una familia de carpinteros. Llevamos más de treinta años dibujando y fabricando cocinas a medida con
          la misma idea del primer día: que estén <em>bien hechas</em>, que se adapten a cada casa y que duren.
        </p>
        <a class="link-arrow" href={url('/nosotros/')} data-reveal style="--d: 0.1s">
          Nuestra historia <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- Pilares -->
  <section class="section section--tight pilares" aria-label="Por qué Cocinas CMA">
    <div class="container">
      <ol class="pilares__lista" role="list">
        {
          pilares.map((p, i) => (
            <li class="pilar" data-reveal style={`--d: ${i * 0.1}s`}>
              <div class="pilar__cabecera">
                <span class="pilar__num" aria-hidden="true">
                  0{i + 1}
                </span>
                <Icon name={p.icono} class="pilar__icono" />
              </div>
              <h2 class="pilar__titulo">{p.titulo}</h2>
              <p class="pilar__texto">{p.texto}</p>
              <a class="link-arrow" href={url(p.enlace.ruta)}>
                {p.enlace.texto} <Icon name="arrow" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Selección de trabajos -->
  <section class="section trabajos" aria-labelledby="trabajos-titulo">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Proyectos</p>
          <h2 id="trabajos-titulo" data-reveal style="--d: 0.08s">Algunas de nuestras cocinas</h2>
        </div>
        <div data-reveal style="--d: 0.16s">
          <p class="muted">
            Modernas, actuales o rústicas; en laca, madera, cristal o estratificado. Trabajos en casas de nuestros
            clientes y ambientes de nuestra exposición de Humanes.
          </p>
        </div>
      </div>

      <ul class="trabajos__grid" role="list">
        {
          destacados.map((p, i) => (
            <li class={`trabajo trabajo--${i + 1}`} data-reveal style={`--d: ${(i % 3) * 0.08}s`}>
              <a href={url(`/proyectos/#${p.id}`)} class="trabajo__enlace">
                <div class="media trabajo__media" data-reveal="imagen">
                  <Foto
                    src={p.foto}
                    alt={p.alt}
                    pendiente={p.titulo}
                    sizes={i === 0 ? '(min-width: 56em) 58vw, 100vw' : '(min-width: 56em) 42vw, 100vw'}
                    tono={i % 2 ? 'madera' : 'claro'}
                    compacto={i > 0}
                  />
                </div>
                <div class="trabajo__pie">
                  <h3 class="trabajo__titulo">{p.titulo}</h3>
                  <p class="trabajo__meta">
                    {nombreEstilo(p.estilos[0])}
                    {p.acabados.length > 0 && ` · ${p.acabados.map(nombreAcabado).join(', ')}`}
                  </p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="trabajos__mas" data-reveal>
        <a class="btn btn--ghost" href={url('/proyectos/')}>Ver todos los proyectos <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- Fábrica -->
  <section class="section section--dark fabrica" aria-labelledby="fabrica-titulo">
    <div class="container fabrica__grid">
      <div class="media fabrica__media" data-reveal="imagen">
        <Foto
          src={huecos.inicioFabrica.foto}
          alt={huecos.inicioFabrica.alt}
          pendiente={huecos.inicioFabrica.pendiente}
          sizes="(min-width: 56em) 50vw, 100vw"
          tono="oscuro"
        />
      </div>
      <div class="fabrica__texto">
        <p class="eyebrow" data-reveal>Fábrica propia · Cedillo del Condado (Toledo)</p>
        <h2 id="fabrica-titulo" data-reveal style="--d: 0.08s">Lo que diseñamos, <em>lo fabricamos nosotros</em></h2>
        <p class="muted" data-reveal style="--d: 0.16s">
          Tener fábrica propia lo cambia todo: elegimos los materiales, cuidamos cada corte y cada canto, y
          resolvemos cualquier ajuste sin depender de nadie. Por eso podemos ofrecer cocinas a medida de calidad a un
          precio ajustado.
        </p>
        <dl class="fabrica__cifras" data-reveal style="--d: 0.24s">
          {
            cifras.map((c) => (
              <div>
                <dt>{c.texto}</dt>
                <dd>{c.valor}</dd>
              </div>
            ))
          }
        </dl>
        <a class="link-arrow" href={url('/fabrica/')} data-reveal style="--d: 0.3s">
          Cómo trabajamos en la fábrica <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <Valoracion />

  <VisitaExposicion />
  <script>
    import '../scripts/intro';
  </script>
</Base>

<style>
  /* Portada */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + 7rem);
    color: var(--c-on-dark);
    background: var(--c-ink);
  }

  .hero__media :global(.foto-pendiente) {
    padding-top: calc(var(--header-h) + 1.25rem);
  }

  .hero__media :global(.foto-aviso) {
    top: calc(var(--header-h) + 1rem);
    bottom: auto;
  }

  .hero__velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(2 15 61 / 0.55) 0, rgb(2 15 61 / 0) calc(var(--header-h) + 4rem)),
      linear-gradient(0deg, rgb(2 15 61 / 0.85) 0%, rgb(2 15 61 / 0.4) 40%, rgb(2 15 61 / 0) 68%),
      linear-gradient(90deg, rgb(2 15 61 / 0.5), rgb(2 15 61 / 0) 65%);
    pointer-events: none;
  }

  .hero__contenido {
    position: relative;
    padding-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .hero__antetitulo {
    color: var(--c-on-dark);
  }

  .hero__antetitulo::before {
    background: currentColor;
  }

  .hero__titulo {
    max-width: 15ch;
    font-size: var(--fs-display);
    line-height: 0.98;
    color: var(--c-on-dark);
  }

  .hero__intro {
    max-width: 34rem;
    margin-block: 1.75rem 2.25rem;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--c-on-dark-muted);
  }

  .hero__pie {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.25rem;
    border-top: 1px solid var(--c-line-dark);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-on-dark-muted);
  }

  .hero__scroll :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* En móvil el texto ocupa casi toda la foto: velo más alto y uniforme */
  @media (max-width: 47.99em) {
    .hero__velo {
      background: linear-gradient(0deg, rgb(2 15 61 / 0.88) 0%, rgb(2 15 61 / 0.6) 50%, rgb(2 15 61 / 0.45) 100%);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__scroll {
      animation: flotar 2.6s var(--ease) infinite;
    }
  }

  @keyframes flotar {
    50% {
      transform: translateY(0.35rem);
    }
  }


  /* Intro: la portada queda fija mientras se abren las puertas */
  :global(.anima) .intro {
    height: 260svh;
  }

  :global(.anima) .intro .hero {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    overflow: hidden;
  }

  @media (max-width: 47.99em) {
    :global(.anima) .intro {
      height: 190svh;
    }
  }

  .hero__escena {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  :global(.anima) .hero__escena {
    transform: scale(calc(1.14 - 0.14 * var(--zoom, 0)));
    filter: brightness(calc(0.45 + 0.55 * var(--abrir, 0)));
    will-change: transform, filter;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }

  .hero__canvas:global(.is-lista) {
    opacity: 1;
  }

  .hero__aviso {
    top: calc(var(--header-h) + 1rem);
    bottom: auto;
  }

  /* Texto: aparece cuando las puertas ya están casi abiertas */
  :global(.anima) .intro .hero__contenido > *,
  :global(.anima) .intro .hero__pie,
  :global(.anima) .intro .hero__velo {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 0.9s var(--ease),
      transform 0.9s var(--ease);
  }

  :global(.anima) .intro .hero__velo {
    transform: none;
  }

  :global(.anima) .intro.is-abierta .hero__contenido > *,
  :global(.anima) .intro.is-abierta .hero__pie,
  :global(.anima) .intro.is-abierta .hero__velo {
    opacity: 1;
    transform: none;
  }

  :global(.anima) .intro.is-abierta .hero__contenido > :nth-child(2) {
    transition-delay: 0.08s;
  }

  :global(.anima) .intro.is-abierta .hero__contenido > :nth-child(3) {
    transition-delay: 0.16s;
  }

  :global(.anima) .intro.is-abierta .hero__contenido > :nth-child(4) {
    transition-delay: 0.24s;
  }


  /* Modo vídeo: la secuencia ya trae el movimiento */
  :global(.anima) .intro--video .hero__escena {
    transform: none;
    filter: none;
  }

  /* La etiqueta de recreación solo tiene sentido cuando se ve el vídeo */
  .hero__aviso {
    left: 0.75rem;
    right: auto;
    visibility: hidden;
  }

  :global(.anima) .hero__aviso {
    visibility: visible;
  }

  :global(.anima) .intro--video .hero__media :global(.foto-aviso) {
    visibility: hidden;
  }

  .intro__marca {
    display: none;
  }

  :global(.anima) .intro__marca {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: radial-gradient(ellipse at center, rgb(2 15 61 / 0.45), rgb(2 15 61 / 0) 70%);
    pointer-events: none;
    transition: opacity 0.6s var(--ease);
  }

  .intro.is-empezada .intro__marca {
    opacity: 0;
  }

  /* Puertas (solo con animación; sin ella se ve la cocina directamente) */
  .puertas {
    display: none;
  }

  :global(.anima) .puertas {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    perspective: 1800px;
    perspective-origin: 50% 45%;
    pointer-events: none;
  }

  .puerta {
    --giro: calc(var(--abrir, 0) * 104deg);
    position: relative;
    transform-style: preserve-3d;
  }

  .puerta--izq {
    transform-origin: left center;
    transform: rotateY(calc(-1 * var(--giro)));
  }

  .puerta--der {
    transform-origin: right center;
    transform: rotateY(var(--giro));
  }

  .puerta__frente,
  .puerta__dorso {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
  }

  /* Frente en laca azul marino con brillo */
  .puerta__frente {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-inline: clamp(1rem, 4vw, 4rem);
    background:
      linear-gradient(100deg, rgb(255 255 255 / 0) 30%, rgb(255 255 255 / 0.09) 42%, rgb(255 255 255 / 0) 55%),
      linear-gradient(180deg, #0d3f70 0%, #003c6d 45%, #022a52 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      inset 0 -40px 80px rgb(0 0 0 / 0.25);
  }

  .puerta--izq .puerta__frente {
    padding-right: clamp(0.4rem, 1vw, 1rem);
    align-items: flex-end;
    text-align: right;
    border-right: 2px solid rgb(0 0 0 / 0.35);
  }

  .puerta--der .puerta__frente {
    padding-left: clamp(0.4rem, 1vw, 1rem);
    align-items: flex-start;
    text-align: left;
    border-left: 1px solid rgb(255 255 255 / 0.08);
  }

  /* Sombra que gana la puerta al girar */
  .puerta__frente::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #000;
    opacity: calc(var(--abrir, 0) * 0.55);
  }

  /* Gola: hueco del tirador con perfil de aluminio */
  .puerta__gola {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: clamp(1.75rem, 4vh, 2.75rem);
    background: linear-gradient(180deg, #010d1f 0%, #031a33 70%, #b9c2cc 70%, #e6eaee 82%, #8e98a3 100%);
  }

  .puerta__marca {
    font-family: var(--f-sans);
    font-size: clamp(3rem, 1rem + 8vw, 8.5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #f8f5ef;
  }

  .puerta__marca b {
    font-weight: 400;
    color: #e2453c;
  }

  .puerta__dato {
    margin-top: 1.25rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(248 245 239 / 0.7);
  }

  /* Cara interior del mueble (tablero en color madera) */
  .puerta__dorso {
    transform: rotateY(180deg);
    background: linear-gradient(90deg, #8a6845, #a7835b 50%, #8a6845);
    box-shadow: inset 0 0 60px rgb(0 0 0 / 0.35);
  }

  .puertas__aviso {
    position: absolute;
    bottom: clamp(1.5rem, 5vh, 3rem);
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(248 245 239 / 0.8);
    transform: translateX(-50%);
    transition: opacity 0.4s var(--ease);
  }

  .puertas__aviso :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    animation: flotar 2.6s var(--ease) infinite;
  }

  .intro.is-empezada .puertas__aviso {
    opacity: 0;
  }

  @media (max-width: 47.99em) {
    .puerta__marca {
      font-size: clamp(2.4rem, 0.5rem + 10vw, 4rem);
    }

    .puerta__dato {
      font-size: 0.6rem;
      letter-spacing: 0.16em;
    }
  }

  /* Presentación */
  .manifiesto__grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 56em) {
    .manifiesto__grid {
      grid-template-columns: 1fr 3fr;
      gap: 3rem;
    }
  }

  .manifiesto__texto {
    margin-bottom: 2.5rem;
    font-family: var(--f-serif);
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3.1rem);
    font-weight: 500;
    line-height: 1.22;
    color: var(--c-ink);
    text-wrap: pretty;
  }

  .manifiesto__texto em {
    color: var(--c-red);
  }

  /* Pilares */
  .pilares {
    padding-top: 0;
  }

  .pilares__lista {
    display: grid;
    gap: 3rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 56em) {
    .pilares__lista {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(2rem, 3vw, 3.5rem);
    }
  }

  .pilar {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--c-line-strong);
  }

  .pilar__cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    align-self: stretch;
    margin-bottom: 0.5rem;
  }

  .pilar__num {
    font-family: var(--f-serif);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--c-red);
  }

  .pilar :global(.pilar__icono) {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--c-navy);
    stroke-width: 1.1;
  }

  .pilar__titulo {
    font-size: var(--fs-h3);
    font-weight: 600;
  }

  .pilar__texto {
    flex: 1;
    color: var(--c-muted);
  }

  /* Trabajos */
  .trabajos {
