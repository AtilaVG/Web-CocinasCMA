---
/**
 * Hueco para una foto que todavía no tenemos. Se marca claramente como
 * "foto pendiente" para no hacer pasar ninguna imagen por un trabajo real.
 */
import Icon from './Icon.astro';

interface Props {
  texto: string;
  tono?: 'claro' | 'oscuro' | 'madera';
  /** Posición de la etiqueta, para no chocar con textos superpuestos. */
  posicion?: 'centro' | 'arriba' | 'abajo';
  compacto?: boolean;
  class?: string;
}

const { texto, tono = 'claro', posicion = 'centro', compacto = false, class: className } = Astro.props;
---

<div
  class:list={['foto-pendiente', `foto-pendiente--${tono}`, `foto-pendiente--${posicion}`, { 'foto-pendiente--compacto': compacto }, className]}
  role="img"
  aria-label={`Foto pendiente: ${texto}`}
>
  <div class="foto-pendiente__etiqueta" aria-hidden="true">
    <span class="foto-pendiente__titulo"><Icon name="camera" /> Foto pendiente</span>
    {!compacto && <span class="foto-pendiente__texto">{texto}</span>}
  </div>
</div>

<style>
  .foto-pendiente {
    --fp-bg: var(--c-stone);
    --fp-line: rgb(2 15 61 / 0.07);
    --fp-fg: var(--c-ink);
    position: relative;
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 8rem;
    padding: clamp(1rem, 3vw, 2rem);
    color: var(--fp-fg);
    background-color: var(--fp-bg);
    background-image:
      repeating-linear-gradient(135deg, var(--fp-line) 0 1px, transparent 1px 14px),
      radial-gradient(120% 90% at 70% 20%, rgb(255 255 255 / 0.35), transparent 60%);
    place-items: center;
  }

  .foto-pendiente--arriba {
    place-items: start end;
  }

  .foto-pendiente--abajo {
    place-items: end start;
  }

  .foto-pendiente--oscuro {
    --fp-bg: #0b1d45;
    --fp-line: rgb(248 245 239 / 0.06);
    --fp-fg: var(--c-on-dark);
    background-image:
      repeating-linear-gradient(135deg, var(--fp-line) 0 1px, transparent 1px 14px),
      radial-gradient(110% 90% at 75% 15%, rgb(0 60 109 / 0.9), transparent 65%),
      linear-gradient(180deg, #102654, #061234);
  }

  .foto-pendiente--madera {
    --fp-bg: #d9c7ab;
    --fp-line: rgb(91 63 33 / 0.1);
    --fp-fg: #3a2a18;
  }

  .foto-pendiente__etiqueta {
    display: grid;
    gap: 0.4rem;
    max-width: 22rem;
    padding: 0.85rem 1.05rem;
    border: 1px dashed currentColor;
    background: color-mix(in srgb, var(--fp-bg) 80%, transparent);
    text-align: left;
  }

  .foto-pendiente__titulo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .foto-pendiente__titulo :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .foto-pendiente__texto {
    font-family: var(--f-serif);
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.3;
  }

  .foto-pendiente--compacto .foto-pendiente__etiqueta {
    padding: 0.5rem 0.75rem;
  }
</style>
