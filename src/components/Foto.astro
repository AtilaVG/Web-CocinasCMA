---
/**
 * Foto optimizada (AVIF/WebP en varios tamaños) o, si aún no existe el
 * archivo, un hueco "foto pendiente" con la descripción de lo que falta.
 */
import { Picture } from 'astro:assets';
import FotoPendiente from './FotoPendiente.astro';
import { buscarFoto } from '../data/fotos';

interface Props {
  src?: string | null;
  alt: string;
  pendiente?: string;
  sizes?: string;
  anchos?: number[];
  prioridad?: boolean;
  tono?: 'claro' | 'oscuro' | 'madera';
  posicion?: 'centro' | 'arriba' | 'abajo';
  compacto?: boolean;
  /**
   * Ancho mínimo para verse bien en ese hueco. Si la foto es más pequeña se
   * marca como provisional (útil en el prototipo para pedir fotos nuevas).
   */
  minAncho?: number;
  class?: string;
}

const {
  src,
  alt,
  pendiente,
  sizes = '100vw',
  anchos = [480, 800, 1200, 1600, 2400],
  prioridad = false,
  tono,
  posicion,
  compacto,
  minAncho = 0,
  class: className,
} = Astro.props;

const img = buscarFoto(src);
// No generamos tamaños mayores que el original.
const widths = img
  ? [...new Set([...anchos.filter((w) => w < img.width), Math.min(img.width, Math.max(...anchos))])]
  : [];
---

{
  img ? (
    <Picture
      src={img}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={prioridad ? 'eager' : 'lazy'}
      fetchpriority={prioridad ? 'high' : 'auto'}
      decoding={prioridad ? 'sync' : 'async'}
      class={className}
    />
  ) : (
    <FotoPendiente texto={pendiente ?? alt} tono={tono} posicion={posicion} compacto={compacto} class={className} />
  )
}
{
  img && img.width < minAncho && (
    <span class="foto-aviso tag-pendiente">Foto provisional · {img.width} px, pedir en alta</span>
  )
}
