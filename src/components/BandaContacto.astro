---
/** Cierre de página discreto: invitación a hablar, sin presión. */
import Icon from './Icon.astro';
import { telPrincipal } from '../config/empresa';
import { url } from '../lib/url';

interface Props {
  titulo?: string;
  texto?: string;
}

const {
  titulo = '¿Hablamos de tu cocina?',
  texto = 'Pásate por la exposición o llámanos. Te escuchamos, medimos y te enseñamos cómo quedaría, sin compromiso.',
} = Astro.props;
---

<section class="banda section--stone" aria-labelledby="banda-titulo">
  <div class="container banda__grid">
    <div data-reveal>
      <h2 id="banda-titulo">{titulo}</h2>
      <p class="muted">{texto}</p>
    </div>
    <div class="btn-row" data-reveal style="--d: 0.1s">
      <a class="btn" href={url('/contacto/')}>Contacto <Icon name="arrow" /></a>
      <a class="btn btn--ghost" href={`tel:${telPrincipal.e164}`}><Icon name="phone" /> {telPrincipal.texto}</a>
    </div>
  </div>
</section>

<style>
  .banda {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }

  .banda__grid {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  @media (min-width: 56em) {
    .banda__grid {
      grid-template-columns: 1.4fr auto;
      gap: 4rem;
    }
  }

  .banda h2 {
    margin-bottom: 0.85rem;
  }

  .banda p {
    max-width: 36rem;
  }
</style>
